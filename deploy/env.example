# Copy to deploy/.env (gitignored) and fill in. Never commit real values.
GATEWAY_DOMAIN=hooks.example.com

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-key

# One per registered source; names must match WG_SOURCE_<NAME>_SECRET.
WG_SOURCE_PAYMENTS_SECRET=

# From `npm run setup:auth` (copy the two values it writes to .env.local).
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Optional
# WG_METRICS_TOKEN=
# WG_INGEST_RATE_PER_MINUTE=600
# WG_INGEST_AUTH_FAILURES_PER_MINUTE=30
# WG_RETAIN_DELIVERED_DAYS=30
# WG_RETAIN_DEAD_LETTERED_DAYS=90
